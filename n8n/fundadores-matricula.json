      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ¿Ya está en el grupo de fundadores? Si Evolcampus no devuelve matrículas, se da por no matriculado.\nconst grupo = Number($('Parsea respuesta').first().json.grupo_id);\nconst data = $json.data || [];\nconst enGrupo = data.find(m => Number(m.enroll?.groupid) === grupo);\nreturn { json: {\n  en_grupo: Boolean(enGrupo),\n  userid: enGrupo?.person?.userid ?? '',\n  enrollmentid: enGrupo?.person?.enrollmentid ?? '',\n}};"
