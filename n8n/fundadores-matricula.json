    {
      "parameters": {
        "jsCode": "// Texto propio de la respuesta (sin el correo citado) y comparación con la palabra clave.\nconst cfg = $('⚙️ Config respuesta').first().json;\nif (!cfg.grupo_id) throw new Error('Falta el ID del grupo de fundadores en «⚙️ Config respuesta».');\n\nreturn $input.all().map(item => {\n  const msg = item.json;\n  const propio = (msg.text || '').split(/\\r?\\nEl \\S+, \\d+ \\S+ \\d{4}[\\s\\S]*$/)[0].split(/\\r?\\nOn .+wrote:[\\s\\S]*$/)[0].trim();\n  const keyword = (propio.split(/\\s+/)[0] || '').replace(/[^\\p{L}\\p{N}]/gu, '').toUpperCase();\n  return { json: {\n    email: (msg.from?.value?.[0]?.address || '').toLowerCase(),\n    es_respuesta: Boolean(msg.headers?.['in-reply-to'] || msg.inReplyTo),\n    respuesta: propio.slice(0, 200),\n    keyword,\n    keyword_valida: keyword === String(cfg.palabra_clave).trim().toUpperCase(),\n    grupo_id: cfg.grupo_id,\n    aviso_a: cfg.aviso_a,\n  }};\n});"
      },
